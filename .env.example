# hndaily environment variables (ticket 08)
#
# These are added to the shared root .env file that docker-compose already
# reads (ticket 07) — do not create a separate .env for this project, and
# never commit real values to git.

# From OCI Console > Developer Services > Email Delivery > Configuration.
HNDAILY_SMTP_HOST=smtp.email.<region>.oci.oraclecloud.com
# Optional, defaults to 465 (implicit TLS). Use 587 for STARTTLS instead.
HNDAILY_SMTP_PORT=465

# From OCI Console > Profile > My Profile > SMTP Credentials > Generate Credentials.
# The password is shown exactly once when generated — store it here immediately.
HNDAILY_SMTP_USERNAME=
HNDAILY_SMTP_PASSWORD=

# Must be an OCI Email Delivery Approved Sender (OCI Console > Developer
# Services > Email Delivery > Configuration > Approved Senders).
HNDAILY_FROM_ADDRESS=

# Optional. Your healthchecks.io check's ping URL (ticket 11). If unset,
# the heartbeat ping is skipped and only Docker's restart policy covers
# failures.
HNDAILY_HEARTBEAT_URL=https://hc-ping.com/your-check-id

# Optional. A ntfy.sh topic name (publishes to https://ntfy.sh/<topic>) for
# a Notification on every Delivery run's outcome — success or failure —
# unlike the content-free Heartbeat above. A short-term addition until the
# Heartbeat alone proves reliable. If unset, Notifications are skipped.
HNDAILY_NTFY_TOPIC=your-hndaily-topic

# Optional, defaults to "config.json" / "data/hndaily.sqlite" — only needed
# if your compose mount paths differ from the defaults.
# HNDAILY_CONFIG_PATH=config.json
# HNDAILY_DB_PATH=data/hndaily.sqlite
