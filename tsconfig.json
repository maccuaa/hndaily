{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ESNext"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"types": ["bun-types"]
	},
	"include": ["src", "test"]
}
